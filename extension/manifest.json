{
  "manifest_version": 3,
  "name": "Hoshiyar scam check",
  "short_name": "Hoshiyar",
  "version": "0.2.0",
  "description": "Right-click a message or link to check it for scam signs, and get a warning on look-alike bank and government sites. Look-alike checks run in your browser.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Hoshiyar scam check",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["https://*.onrender.com/*", "http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "optional_host_permissions": ["https://*/*"],
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lookalike.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
