# Copy this file to .env and fill in what you have. Everything is optional:
# with no keys at all the app still runs in "rules only" mode.

# --- AI (free tiers) ---------------------------------------------------------
# Groq: chat models + Whisper for voice notes. https://console.groq.com/keys
# llama-3.3-70b-versatile was retired for free keys on 2026-08-16; use the gpt-oss models.
# If a model here is retired later, the app picks a current one at start-up and logs it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Second Groq model with its own free quota; the tool-calling agents use it first. Empty = off.
GROQ_FAST_MODEL=openai/gpt-oss-20b
# low | medium | high  (low keeps answers fast and inside the free tokens-per-minute limit)
GROQ_REASONING_EFFORT=low
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Google AI Studio: screenshot reading, embeddings, and backup chat model.
# https://aistudio.google.com/apikey
# Free-tier prompts may be used by Google to improve its products, so the app removes
# phone numbers, CNICs and card numbers before sending any text.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# auto | groq | gemini | none
# auto with both keys: Groq main -> Gemini -> Groq fast. A model that fails (retired, rate
# limit) is skipped for a while; with every model resting, the rules answer on their own.
LLM_PROVIDER=auto
# Check at start-up that the configured models still exist and replace retired ones.
MODEL_AUTOSELECT=true
# auto | gemini | local   (local = free hashing embedder, no API calls)
EMBEDDINGS_PROVIDER=auto

# --- Database (Neon free tier, optional) -----------------------------------
# Leave empty to use a local SQLite file and in-memory agent memory.
# Use Neon's DIRECT connection string (not the "-pooler" host), e.g.
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Link checks -------------------------------------------------------------
ENABLE_NETWORK_CHECKS=true
# Optional. Safe Browsing API key from Google Cloud console (non-commercial use only).
SAFE_BROWSING_API_KEY=

# --- Telegram bot (optional) ---------------------------------------------------
# Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=
# Any long random string; Telegram sends it back so we know requests are genuine.
TELEGRAM_WEBHOOK_SECRET=
# Optional channel for the weekly warning, e.g. @hoshiyar_alerts (add the bot as an admin of the channel).
TELEGRAM_ALERT_CHAT_ID=

# --- Review panel (analysts and admins) -------------------------------------------
# Signs login tokens. A long random string (16+ characters). Login stays off in production, or
# with a DATABASE_URL, until it is set. Make one: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=
# The first admin account is created from these when there are no users yet (password: 10+ characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Scheduled jobs and integrations -----------------------------------------------
# Secret for /api/cron/weekly and /api/cron/purge (GitHub Actions sends it as X-Cron-Secret).
CRON_SECRET=
# Lets the browser extension and the MCP server skip the captcha (header X-Hoshiyar-Key).
INTEGRATION_KEY=
# Optional Cloudflare Turnstile secret key (free). Set VITE_TURNSTILE_SITE_KEY in the frontend too.
TURNSTILE_SECRET=
# Website address, used in Telegram messages, e.g. https://hoshiyar.vercel.app
PUBLIC_APP_URL=

# --- App -----------------------------------------------------------------------
# Comma-separated frontend URLs allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Any long random string. Used to fingerprint phone numbers so they are never stored.
FINGERPRINT_SECRET=change-me-to-a-long-random-string
# Adds clearly labelled sample rows so the trends page is not empty on a new deploy.
SEED_DEMO_DATA=true
RATE_LIMIT_PER_MINUTE=20
# Gemini embeddings: similarity needed to count a stored scam as "similar" (calibrated, see eval/calibrate_memory.py).
SIMILARITY_THRESHOLD_GEMINI=0.90
# A phone number or account counts as reported after a reviewer approves it, or after this many
# different Telegram accounts report it (browser ids are free to fake, so they do not count).
MIN_INDEPENDENT_REPORTERS=2
# Finding the visitor's address for rate limits. On Render, Cloudflare sets CF-Connecting-IP;
# otherwise X-Forwarded-For is read this many entries from the end (Render: 3). 0 = ignore both.
CLIENT_IP_HEADER=cf-connecting-ip
TRUSTED_PROXY_HOPS=3

# --- Data retention (days) ----------------------------------------------------------
RETENTION_ANALYSES_DAYS=180
RETENTION_REJECTED_DAYS=30
RETENTION_PENDING_DAYS=90
AI_CACHE_DAYS=7
